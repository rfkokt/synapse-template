# ═══════════════════════════════════════════════
# .npmrc — Private NPM Registry untuk @synapse/*
# Copy file ini ke .npmrc di setiap repo standalone
# Pilih SATU opsi registry di bawah (GitHub ATAU GitLab)
# ═══════════════════════════════════════════════

# ── Opsi 1: GitLab Package Registry (Private) ──
# Ganti <PROJECT_ID> dengan ID proyek GitLab kamu
@synapse:registry=https://gitlab.com/api/v4/projects/<PROJECT_ID>/packages/npm/
//gitlab.com/api/v4/projects/<PROJECT_ID>/packages/npm/:_authToken=${GITLAB_TOKEN}

# ── Opsi 2: GitHub Packages (Private) ──
# Uncomment baris di bawah jika pakai GitHub, comment baris GitLab di atas
# @synapse:registry=https://npm.pkg.github.com
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# ── Recommended settings ──
auto-install-peers=true
strict-peer-dependencies=false
