{
  "name": "@synapse/shared-api",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./*": "./dist/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --outDir dist --external react --external @synapse/shared-types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.68.0",
    "axios": "^1.8.0"
  },
  "peerDependencies": {
    "@synapse/shared-types": "workspace:*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "vite": "^7.3.1"
  }
}
