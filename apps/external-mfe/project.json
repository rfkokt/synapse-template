{
  "name": "external-mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/external-mfe/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project external-mfe --web",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run serve",
        "cwd": "apps/external-mfe"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/external-mfe"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run preview",
        "cwd": "apps/external-mfe"
      }
    }
  }
}
