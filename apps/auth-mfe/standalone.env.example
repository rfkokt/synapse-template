# ──────────────────────────────────────────────
# Auth MFE — Standalone Environment Variables
# Copy this file to .env.local when running outside monorepo
# ──────────────────────────────────────────────

# Mock Service Worker (MSW) — set 'false' to use real API
VITE_ENABLE_MSW=true

# API base URL (used when MSW is disabled)
VITE_API_BASE_URL=

# Shell host URL (used for redirect after login in standalone mode)
VITE_SHELL_URL=http://localhost:4000

# Allowed origins for redirect validation (comma-separated)
VITE_ALLOWED_ORIGINS=

# Sentry DSN for error monitoring (leave empty to disable)
VITE_SENTRY_DSN=
